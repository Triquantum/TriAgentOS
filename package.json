{
  "name": "triagentos",
  "version": "1.0.0",
  "description": "TriAgentOS Community Edition — The Open Source AI Operating System by Triquantum Intelligent Systems Pvt Ltd",
  "type": "module",
  "bin": { "tri": "./cli/bin/tri.js" },
  "scripts": {
    "start":            "node cli/bin/tri.js",
    "validate":         "node tools/score-engine/validate-registry.js",
    "discover":         "node tools/github-scanner/discover.js",
    "build:readme":     "node tools/readme-generator/build-readme.js",
    "test":             "node tools/score-engine/validate-registry.js",
    "benchmark":        "node cli/bin/tri.js benchmark --quiet",
    "security":         "node cli/bin/tri.js secure scan --json",
    "security:secrets": "node cli/bin/tri.js secure secrets",
    "security:sast":    "node cli/bin/tri.js secure sast",
    "security:iac":     "node cli/bin/tri.js secure iac",
    "security:report":  "node cli/bin/tri.js secure report",
    "boot":             "node cli/bin/tri.js boot",
    "postinstall":      "node cli/bin/setup.js"
  },
  "keywords": ["ai","llm","agents","claude","openai","gemini","groq","ollama","deepseek","mistral","llama","qwen","automation","ai-os","agent-swarm","multi-agent","triquantum","triagentos","ai-security","ai-operating-system"],
  "author": "Triquantum Intelligent Systems Pvt Ltd",
  "license": "MIT",
  "dependencies": {
    "chalk":           "^5.3.0",
    "cli-table3":      "^0.6.3",
    "commander":       "^12.0.0",
    "dotenv":          "^16.4.4",
    "figlet":          "^1.7.0",
    "gradient-string": "^2.0.2",
    "inquirer":        "^9.2.15",
    "marked":          "^12.0.0",
    "marked-terminal": "^7.0.0",
    "node-fetch":      "^3.3.2",
    "ora":             "^8.0.1",
    "boxen":           "^7.1.1",
    "p-limit":         "^5.0.0",
    "uuid":            "^9.0.0"
  },
  "engines": { "node": ">=18.0.0" },
  "repository": { "type": "git", "url": "https://github.com/Triquantum/TriAgentOS.git" },
  "homepage": "https://github.com/Triquantum/TriAgentOS",
  "bugs": { "url": "https://github.com/Triquantum/TriAgentOS/issues" }
}
