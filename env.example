# TriAgentOS Environment Variables
# Copy this file to .env and fill in your keys
# You only need ONE provider to get started

# Anthropic (Claude) — https://console.anthropic.com
ANTHROPIC_API_KEY=

# OpenAI (GPT-4o) — https://platform.openai.com
OPENAI_API_KEY=

# Google Gemini — https://aistudio.google.com
GEMINI_API_KEY=

# Groq (Fast & Free tier) — https://console.groq.com
GROQ_API_KEY=

# Ollama (local, free) — https://ollama.ai
# No API key needed — just install ollama and run: ollama pull llama3
OLLAMA_BASE_URL=http://localhost:11434

# GitHub (for ecosystem discovery feature)
GITHUB_TOKEN=
