{
  "version": "1.0.0",
  "edition": "community",
  "scanners": {
    "secrets": {
      "enabled": true,
      "extensions": [".js", ".ts", ".py", ".env", ".json", ".yml", ".yaml", ".sh"],
      "excludeDirs": ["node_modules", ".git", "dist", "build", "coverage"]
    },
    "sast": {
      "enabled": true,
      "extensions": [".js", ".ts", ".jsx", ".tsx", ".py"],
      "excludeDirs": ["node_modules", ".git"]
    },
    "iac": {
      "enabled": true,
      "filePatterns": ["Dockerfile", "*.yml", "*.yaml", "*.tf"],
      "excludeDirs": ["node_modules"]
    },
    "dependencies": { "enabled": true, "checkLockfile": true, "failOnHigh": false },
    "container": { "enabled": true, "scanDockerfile": true },
    "lint": { "enabled": false, "note": "Requires ESLint installed: npm install -g eslint" },
    "aiReview": { "enabled": false, "note": "AI-powered review requires an API key configured" }
  },
  "reporting": {
    "outputDir": "core/security/reports",
    "formats": ["json", "markdown"],
    "includeRemediation": true
  },
  "policies": {
    "failOnCritical": true,
    "failOnHigh": false,
    "blockCommitOnCritical": false,
    "note": "Set blockCommitOnCritical:true and add to .git/hooks/pre-commit for enforcement"
  },
  "integrations": {
    "gitleaks": { "enabled": false, "note": "Install gitleaks for advanced secret detection" },
    "trivy":    { "enabled": false, "note": "Install trivy for container and dependency scanning" },
    "checkov":  { "enabled": false, "note": "Install checkov for IaC policy-as-code" },
    "semgrep":  { "enabled": false, "note": "Install semgrep for advanced SAST" }
  }
}
